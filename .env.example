# Development-only examples. Copy to .env and replace placeholders before starting Compose.
DB_URL=jdbc:postgresql://localhost:5432/crosspay
DB_USERNAME=crosspay
DB_PASSWORD=replace-with-a-database-password
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRATION=900000
# Comma-separated browser origins; leave blank to deny cross-origin browser access by default.
CORS_ALLOWED_ORIGINS=
SERVER_PORT=8080
